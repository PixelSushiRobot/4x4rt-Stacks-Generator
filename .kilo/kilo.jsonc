{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "figma-desktop": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
    },
  },
  "autoApprove": {
    "read": true, // Auto-approve reading files and workspace structure
    "write": false, // REQUIRE APPROVAL: The agent will pause and show diffs before writing to index.html
    "mcp": ["figma-desktop"], // Auto-approve inspecting Figma Dev Mode design tokens
    "execute": false, // REQUIRE APPROVAL: Terminal commands pause for user confirmation
  },
  "auto_collapse_reasoning": true,
  "terminal_command_display": "collapsed",
}
